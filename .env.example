# Default: local photos, no external account or billing.
EW_PHOTO_STORAGE=local
EW_DATA_DIR=/data
EW_SECURE_COOKIES=1

# Render Free: use the Supabase Session pooler URL, including sslmode.
# DATABASE_URL=postgresql://postgres.kiuvljeudopvaumkkrrd:ENCODED_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
# EW_DB_SCHEMA=app_private

# Optional R2: enable ONLY after accepting Cloudflare's usage-based billing.
# EW_PHOTO_STORAGE=r2
# EW_R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# EW_R2_BUCKET=18wheelers-photos
# EW_R2_ACCESS_KEY_ID=REPLACE_IN_HOSTING_SECRET_SETTINGS
# EW_R2_SECRET_ACCESS_KEY=REPLACE_IN_HOSTING_SECRET_SETTINGS
# EW_R2_PREFIX=18wheelers/photos
# EW_R2_URL_TTL_SECONDS=300

# This file documents settings. The app does NOT automatically load .env.
# Set environment variables in Render/Railway or export them before starting locally.
# For local HTTP, use EW_SECURE_COOKIES=0 and a writable EW_DATA_DIR.

# Upload / storage protections (server enforced, persist across restarts).
EW_PHOTO_TOTAL_LIMIT_MB=5000
EW_PHOTO_MAX_STORED_KB=300
EW_PHOTO_MAX_DIMENSION=1600
EW_PHOTO_WEBP_QUALITY=80
EW_PHOTO_MAX_PER_JOB=100
EW_UPLOAD_REQUESTS_USER_MINUTE=3
EW_UPLOAD_REQUESTS_GLOBAL_MINUTE=20
EW_UPLOAD_PHOTOS_USER_DAY=100
EW_UPLOAD_PHOTOS_GLOBAL_DAY=500
EW_UPLOAD_REQUESTS_GLOBAL_MONTH=50000
EW_PHOTO_READS_USER_MINUTE=120
EW_PHOTO_READS_GLOBAL_MONTH=500000
