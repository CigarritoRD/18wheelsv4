# Supabase Postgres. Copy the Session pooler connection string from Connect in
# the Supabase dashboard and replace the password. Do not use the transaction
# pooler (port 6543) with this long-running FastAPI service.
DATABASE_URL=postgresql://postgres.kiuvljeudopvaumkkrrd:ENCODED_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
EW_DB_POOL_SIZE=5

# One-time bootstrap secret. Generate at least 32 random characters and remove
# or rotate it after the first admin account has been created.
EW_SETUP_TOKEN=replace-with-a-long-random-bootstrap-secret

# Cloudflare R2 S3 credentials for a private bucket.
R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET=18wheelers-job-photos

# Required when the deployed site is served over HTTPS.
EW_SECURE_COOKIES=1
EW_HOST=0.0.0.0
PORT=8080
